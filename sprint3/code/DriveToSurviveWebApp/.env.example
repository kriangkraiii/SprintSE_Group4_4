# ─── Core ─────────────────────────────────────────────────
# Google Maps API key (ใช้ทั้ง client + server)
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# API Base URL
# Dev  → ไม่ต้องตั้ง (nuxt.config.js proxy ไป localhost:3001 อัตโนมัติ)
# Prod → https://your-koyeb-app.koyeb.app/api
NUXT_PUBLIC_API_BASE=

# Database (MySQL)
DATABASE_URL="mysql://user:password@host:port/database"

# JWT Authentication
JWT_SECRET=your-random-secret-here

# Node Environment (development / production)
NODE_ENV=production

# ─── Cloudinary (Image Upload) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── iApp Thai e-KYC API (OCR บัตรประชาชน / ใบขับขี่) ────
IAPP_API_KEY=

# ─── Admin Bootstrap ─────────────────────────────────────
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ─── SMTP Email (OTP / Arrival Notification) ─────────────
# ใช้ Gmail App Password → https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated allowed origins (e.g. https://your-frontend-domain)
CORS_ORIGINS=

# ─── Sprint 3: Firebase Cloud Messaging (FCM) ────────────
# Push notification ไปโทรศัพท์ / browser ของผู้ใช้

# VAPID Key — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
FIREBASE_VAPID_KEY=

# Firebase Client SDK (public keys — safe to expose in browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Service Account — server-side only)
# สร้างจาก Firebase Console → Project Settings → Service Accounts → Generate new private key
# คัดลอก project_id, client_email, private_key จาก JSON ที่ดาวน์โหลดมา
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
